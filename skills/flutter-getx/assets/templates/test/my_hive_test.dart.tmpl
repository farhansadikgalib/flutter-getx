import 'dart:io';

import 'package:flutter_test/flutter_test.dart';
import 'package:hive_ce/hive.dart';

import 'package:{{package_name}}/app/data/local/my_hive.dart';
import 'package:{{package_name}}/app/data/models/user_model.dart';

void main() {
  late Directory tempDir;

  setUpAll(() async {
    tempDir = await Directory.systemTemp.createTemp('hive_test');
    await MyHive.init(
      testPath: tempDir.path,
      registerAdapters: (hive) => hive.registerAdapter(UserModelAdapter()),
    );
  });

  tearDownAll(() async {
    await Hive.close();
    await tempDir.delete(recursive: true);
  });

  test('saves, reads and deletes the current user', () async {
    const user = UserModel(id: 1, name: 'Leanne', username: 'Bret', email: 'l@example.com');

    expect(await MyHive.saveUserToHive(user), isTrue);
    expect(MyHive.getCurrentUser()?.email, 'l@example.com');

    expect(await MyHive.deleteCurrentUser(), isTrue);
    expect(MyHive.getCurrentUser(), isNull);
  });
}
